# Modèle de configuration — copier en `.env.local` (développement) ou reporter
# dans `.env.docker` (déploiement VPS, voir scripts/deploy.sh).
# Aucune valeur réelle ici : ce fichier est versionné.
#
# ⚠️ Les variables `NEXT_PUBLIC_*` sont figées dans le bundle client PENDANT le
# build. En Docker elles doivent aussi être déclarées en build-arg
# (docker-compose.yml + Dockerfile), pas seulement dans .env.docker.

# ── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/navettexpress

# ── Authentification (NextAuth) ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs publiques ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Mesure d'audience ───────────────────────────────────────────────────────
# Identifiant de mesure Google Analytics 4 (format G-XXXXXXXXXX), à récupérer
# dans GA4 > Admin > Flux de données. Aucun repli dans le code : vide = aucune
# mesure. NEXT_PUBLIC_*, donc à fournir AU BUILD (build-arg), pas au runtime.
NEXT_PUBLIC_GA_ID=

# ── Emails transactionnels (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Signature des webhooks Resend (alimente la liste noire blocked_emails)
RESEND_WEBHOOK_SECRET=
# Destinataires des notifications internes
ADMIN_EMAIL=
CONTACT_EMAIL=

# ── WhatsApp (Geskap / API Cloud Meta) ──────────────────────────────────────
# Voir docs/GESKAP_WHATSAPP.md
GESKAP_API_KEY=
GESKAP_API_BASE_URL=https://wa-api.geskap.com
GESKAP_WEBHOOK_SECRET=
GESKAP_ADMIN_PHONE=
# Délai du rappel avant départ, en minutes (défaut 60)
WHATSAPP_REMINDER_LEAD_MINUTES=60
# Échéance affichée au chauffeur dans 2chauffeur_assigne, en minutes (défaut 30)
WHATSAPP_DRIVER_CONFIRM_MINUTES=30

# ── Collecte d'avis Google ──────────────────────────────────────────────────
# Lien d'avis à GÉNÉRER PAR LE CLIENT depuis le tableau de bord Google Business
# Profile : « Demander des avis » → copier le lien (format
# https://g.page/r/<id>/review). Tant que cette variable est vide, aucune
# demande d'avis n'est envoyée après une course.
GOOGLE_REVIEW_URL=
# Délai entre la fin de course et la demande d'avis, en heures (défaut 2)
REVIEW_REQUEST_DELAY_HOURS=2

# ── Tâches planifiées ───────────────────────────────────────────────────────
# Secret du header `x-cron-secret` attendu par /api/cron/whatsapp-reminders et
# /api/cron/review-requests. Sans valeur, les deux routes répondent 403.
CRON_SECRET=

# ── Médias (Cloudinary) ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Suivi des vols (AviationStack) ──────────────────────────────────────────
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# ── Application mobile (Capacitor) ──────────────────────────────────────────
# Jeton partagé entre le shell mobile et les routes API
APP_API_TOKEN=
NEXT_PUBLIC_APP_API_TOKEN=
