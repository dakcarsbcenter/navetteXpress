# Plages IP officielles Cloudflare (https://www.cloudflare.com/ips/)
# À mettre à jour si Cloudflare les modifie.
(cloudflare_ranges) {
	remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

# www -> domaine nu en 301 : un seul hote indexable (les canonical sont absolus
# vers navettexpress.com, mais deux hotes servant le meme contenu diluent les
# signaux). Le chemin et la requete sont conserves.
www.navettexpress.com {
	redir https://navettexpress.com{uri} permanent
}

navettexpress.com {
	# CF-Connecting-IP n'est fiable que s'il vient de Cloudflare : sinon on le retire
	# pour qu'un client direct ne puisse pas usurper son IP.
	@not_cloudflare not {
		import cloudflare_ranges
	}
	request_header @not_cloudflare -CF-Connecting-IP

	# HSTS volontairement court (5 min) : difficile a annuler une fois en cache
	# navigateur. Montee prevue : 3600 -> 604800 (1 semaine) -> 15552000 (6 mois),
	# sans includeSubDomains ni preload tant que tous les sous-domaines ne sont pas
	# valides en HTTPS. Verifier que l'option HSTS de Cloudflare n'est pas aussi
	# activee (doublon).
	header Strict-Transport-Security "max-age=300"

	reverse_proxy app:3000
}
